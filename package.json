{
  "name": "mgood-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Composable plugins and shared tooling for a better Pi coding-agent experience.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musuyin/mgood-pi.git"
  },
  "bugs": {
    "url": "https://github.com/musuyin/mgood-pi/issues"
  },
  "homepage": "https://github.com/musuyin/mgood-pi#readme",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "changeset": "changeset",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release-packages": "changeset publish",
    "stage-release-packages": "node ./scripts/stage-release-packages.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
