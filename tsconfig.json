{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@mgood-pi/core": ["packages/core/src/index.ts"],
      "@mgood-pi/git": ["packages/git/src/index.ts"],
      "@mgood-pi/plan-workflow-core": ["packages/plan-workflow/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "plugins/*/src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/build/**", "**/dist/**", "**/node_modules/**"]
}
