{
  "name": "@mgood-pi/plugin-plan-workflow",
  "version": "0.2.0",
  "description": "Interactive bilingual Feature, Work Plan execution, and implementation review workflow for Pi.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/musuyin/mgood-pi.git",
  "homepage": "https://github.com/musuyin/mgood-pi#readme",
  "bugs": "https://github.com/musuyin/mgood-pi/issues",
  "keywords": [
