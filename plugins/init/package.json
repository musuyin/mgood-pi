{
  "name": "@mgood-pi/plugin-init",
  "version": "0.1.0",
  "description": "Pi extension providing the /mgood:init project bootstrap command.",
  "license": "MIT",
  "repository": "https://github.com/musuyin/mgood-pi.git",
  "homepage": "https://github.com/musuyin/mgood-pi#readme",
  "bugs": "https://github.com/musuyin/mgood-pi/issues",
  "keywords": [
    "pi-package",
    "pi",
    "plugin",
    "bootstrap"
  ],
  "type": "module",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@mgood-pi/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
