{
  "name": "@mgood-pi/plan",
  "version": "0.2.0",
  "description": "A focused Plan mode for Pi that clarifies requests and writes one local Markdown plan.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/musuyin/mgood-pi.git",
  "homepage": "https://github.com/musuyin/mgood-pi#readme",
  "bugs": "https://github.com/musuyin/mgood-pi/issues",
  "keywords": [
    "pi-package",
    "pi",
    "plugin",
    "plan",
    "planning"
  ],
  "files": [
    "src/index.ts",
    "prompts/plan.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
