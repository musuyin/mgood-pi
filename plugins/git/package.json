{
  "name": "@mgood-pi/plugin-git",
  "version": "1.0.0",
  "description": "Pi extension that launches Agent-planned safe commit workflows and provides configured-upstream pushes.",
  "license": "MIT",
  "repository": "https://github.com/musuyin/mgood-pi.git",
  "homepage": "https://github.com/musuyin/mgood-pi#readme",
  "bugs": "https://github.com/musuyin/mgood-pi/issues",
  "keywords": [
    "pi-package",
    "pi",
    "plugin",
    "git",
    "safety"
  ],
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "prompts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@mgood-pi/git": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
